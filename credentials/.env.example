# ════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES TEMPLATE WITH CREDENTIAL ACQUISITION INSTRUCTIONS
# ════════════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp credentials/.env.example credentials/.env.local
# 2. Open credentials/.env.local in your editor
# 3. Find each section below and follow the "HOW TO GET" instructions
# 4. Replace placeholder values with your actual credentials
# 5. IMPORTANT: Never commit .env.local to git - only .env.example
#
# IMPORTANT SECURITY NOTES:
# • Never use the same password/API key for development and production
# • Rotate credentials regularly (every 60-90 days)
# • Use environment-specific values (.env.production, .env.development, etc.)
# • Store in Google Secrets Manager for production deployments
# • Use least-privilege access for all API keys and service accounts
# ════════════════════════════════════════════════════════════════════════════

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# HOW TO GET: 
# Local Dev: Install MySQL locally or use Docker: docker run -e MYSQL_ROOT_PASSWORD=pass -p 3306:3306 mysql:8.0
# GCP: Create Cloud SQL instance at https://console.cloud.google.com/sql/instances
# Format: mysql://username:password@host:port/database_name
DATABASE_URL=mysql://username:password@localhost:3306/ev_charging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=true
ENVIRONMENT=development

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# IMPORTANT: Generate a strong SECRET_KEY with: openssl rand -hex 32 (Linux/Mac)
# Or Python: python -c "import secrets; print(secrets.token_hex(32))"
# Never share or hardcode in version control
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
# CORS: Add your frontend URL and any allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# GOOGLE CLOUD PLATFORM (GCP)
# ============================================================================
# HOW TO SET UP:
# 1. Create GCP Project: https://console.cloud.google.com
# 2. Create Service Account: IAM & Admin > Service Accounts > Create Service Account
# 3. Create Key: Actions > Manage Keys > Add Key > JSON (save to credentials/keys/gcp-service-key.json)
# 4. Grant Roles: Cloud SQL Client, Cloud Storage Admin, Cloud Run Admin
# 5. Get Project ID from https://console.cloud.google.com/project
GOOGLE_PROJECT_ID=ev-charging-dev
GOOGLE_CREDENTIALS_PATH=./credentials/keys/gcp-service-key.json
GCP_REGION=us-central1
GCP_BUCKET_NAME=ev-charging-dev-bucket

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_TIMEOUT=30000
# HOW TO GET Google Maps API Key:
# 1. Go to https://console.cloud.google.com/google/maps-apis/overview
# 2. Enable Maps JavaScript API
# 3. Go to Credentials > Create Credentials > API Key
# 4. Copy API Key here. For MAPS_ID, go to Maps > Maps Management > Create Map ID
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
REACT_APP_GOOGLE_MAPS_ID=your-google-maps-id-here
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================================================
# MACHINE LEARNING / DATA SCIENCE
# ============================================================================
ML_MODEL_PATH=./data-science/models/demand_forecast_latest.pkl
ML_SERVICE_URL=http://localhost:8001
ML_BATCH_SIZE=100
ML_PREDICTION_TIMEOUT=60
PREDICTION_CACHE_TTL=3600

# ============================================================================
# EMAIL CONFIGURATION (for notifications and password reset)
# ============================================================================
# HOW TO SET UP Gmail:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Copy generated 16-character password to SMTP_PASSWORD
# For other email providers, use their SMTP settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@evchargingstation.com
SMTP_FROM_NAME=EV Charging Station

# ============================================================================
# REDIS CONFIGURATION (for caching and sessions)
# ============================================================================
# HOW TO SET UP Redis:
# Local Dev Option 1 - Docker: docker run -d -p 6379:6379 redis:7-alpine
# Local Dev Option 2 - Install: brew install redis (Mac) or apt install redis (Linux)
# Windows: Use Windows Subsystem for Linux (WSL) or Docker Desktop
# Production: Use Google Cloud Memorystore or AWS ElastiCache
# URL Format: redis://[password@]host:port/database_number
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600
CACHE_ENABLED=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# PAYMENT PROCESSING (Stripe - if applicable)
# ============================================================================
# HOW TO GET Stripe Keys:
# 1. Create Stripe Account: https://dashboard.stripe.com/register
# 2. Go to Developers > API Keys > Copy Secret Key (starts with sk_test_)
# 3. Copy Publishable Key (starts with pk_test_)
# 4. For Webhooks: Developers > Webhooks > Add Endpoint (copy webhook secret)
STRIPE_API_KEY=sk_test_your-test-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# ============================================================================
# THIRD-PARTY API KEYS
# ============================================================================
# Weather API: Sign up at https://openweathermap.org/api, get free API key
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_URL=https://api.openweathermap.org
# Traffic API: API key from your traffic data provider
TRAFFIC_API_KEY=your-traffic-api-key
# Maps API: Available from https://console.cloud.google.com (same as Google Maps)
MAPS_API_KEY=your-maps-platform-key

# ============================================================================
# GEOLOCATION & MAPPING
# ============================================================================
DEFAULT_MAP_CENTER_LAT=28.5355
DEFAULT_MAP_CENTER_LNG=77.3910
DEFAULT_MAP_ZOOM=12
MAP_SEARCH_RADIUS_KM=50

# ============================================================================
# FEATURE FLAGS (for gradual rollout)
# ============================================================================
FEATURE_DEMAND_FORECASTING=true
FEATURE_FAULT_DETECTION=true
FEATURE_USER_ANALYTICS=true
FEATURE_BILLING_INTEGRATION=false
FEATURE_MOBILE_APP=false

# ============================================================================
# RATE LIMITING & THROTTLING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_PER_USER=50

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Sentry (Error Tracking): Sign up at https://sentry.io, create project, copy DSN
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id
SENTRY_ENVIRONMENT=development
# Datadog (Monitoring): Sign up at https://datadog.com, get API key from Integrations
DATADOG_API_KEY=your-datadog-api-key
DATADOG_ENVIRONMENT=development

# ============================================================================
# CELERY (for background tasks)
# ============================================================================
# HOW TO SET UP Celery:
# Requires Redis to be running (see REDIS_CONFIGURATION above)
# Start Celery worker: celery -A app.celery worker --loglevel=info
# Uses separate Redis databases to avoid conflicts with cache
# CELERY_BROKER_URL: Where task messages are sent
# CELERY_RESULT_BACKEND: Where task results are stored
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=900

# ============================================================================
# AWS (if using AWS instead of GCP)
# ============================================================================
# HOW TO GET AWS Keys:
# 1. Create AWS Account: https://aws.amazon.com
# 2. IAM > Users > Create User > Attach policies (S3, RDS, CloudWatch)
# 3. Security Credentials > Create Access Key > Download CSV
# 4. Copy Access Key ID and Secret Access Key
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ev-charging-bucket

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
DEBUG=false
DEVELOPMENT_MODE=false
MOCK_ML_PREDICTIONS=false
MOCK_PAYMENT_SERVICE=false
SEED_DATABASE=false

# ============================================================================
# KUBERNETES CONFIGURATION (if using K8s)
# ============================================================================
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=default
KUBERNETES_REPLICAS=3

# ============================================================================
# SECURITY
# ============================================================================
ALLOWED_HOSTS=localhost,127.0.0.1
HTTPS_ONLY=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ============================================================================
# PAGINATION & LIMITS
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_FILTER_RESULTS=1000

# ============================================================================
# TIME ZONE
# ============================================================================
TIME_ZONE=Asia/Kolkata
DATE_FORMAT=%d-%m-%Y
TIME_FORMAT=%H:%M:%S

# ════════════════════════════════════════════════════════════════════════════
# QUICK START GUIDE - LOCAL DEVELOPMENT SETUP
# ════════════════════════════════════════════════════════════════════════════
#
# STEP 1: Prerequisites - Install Docker & Docker Compose
# ─────────────────────────────────────────────────────────
# macOS/Windows: Download from https://www.docker.com/products/docker-desktop
# Linux: sudo apt-get install docker.io docker-compose
#
# STEP 2: Start Local Services with Docker Compose
# ─────────────────────────────────────────────────────────
# docker-compose up -d
# This starts:
#   • MySQL Database on localhost:3306
#   • Redis Cache on localhost:6379
#   • (Optional) Mailhog for email testing on localhost:1025
#
# STEP 3: Copy & Configure .env.local
# ─────────────────────────────────────────────────────────
# cp credentials/.env.example credentials/.env.local
#
# Then fill in ONLY these required for local development:
#
# Required for Local Dev:
#   ✓ DATABASE_URL=mysql://root:password@localhost:3306/ev_charging
#   ✓ SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"
#   ✓ REDIS_URL=redis://localhost:6379/0
#   ✓ API_PORT=8000
#
# Optional (for testing payment/SMS features):
#   ○ STRIPE_API_KEY (get from https://stripe.com)
#   ○ SMTP_PASSWORD (for email. Use Mailhog: smtp.mailhog:1025)
#   ○ GOOGLE_CREDENTIALS_PATH (not needed for local dev)
#
# STEP 4: Create Database
# ─────────────────────────────────────────────────────────
# cd backend
# alembic upgrade head
#
# STEP 5: Install & Run Backend
# ─────────────────────────────────────────────────────────
# pip install -r requirements.txt
# python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000
# Access API docs: http://localhost:8000/docs
#
# STEP 6: Install & Run Frontend (in new terminal)
# ─────────────────────────────────────────────────────────
# cd frontend
# npm install
# npm run dev
# Access app: http://localhost:3000
#
# STEP 7: Start ML Service (in another terminal - optional)
# ─────────────────────────────────────────────────────────
# cd data-science
# python -m uvicorn predictions/serve_predictions.py --host 0.0.0.0 --port 8001
#
# ════════════════════════════════════════════════════════════════════════════
# CREDENTIAL PRIORITY BY ENVIRONMENT
# ════════════════════════════════════════════════════════════════════════════
#
# LOCAL DEVELOPMENT ⬅ Minimal Credentials Needed
# ├─ Use localhost for all services (MySQL, Redis)
# ├─ Mock external APIs (Stripe, WeatherAPI)
# ├─ No GCP/AWS credentials required
# └─ Use debug/test API keys
#
# STAGING ⬅ Full Credentials Required
# ├─ Use GCP Cloud SQL & Memorystore
# ├─ Real (test) Stripe keys
# ├─ GCP service account key
# └─ Real (test) external API keys
#
# PRODUCTION ⬅ Security-Critical Setup
# ├─ Use Google Secrets Manager (NOT .env files)
# ├─ Real Stripe production keys
# ├─ Limited service account permissions (least privilege)
# ├─ API key rotation every 60-90 days
# └─ Encrypted database connections (SSL/TLS)
#
# ════════════════════════════════════════════════════════════════════════════
# MOCK DATA SETUP - For Development Without External APIs
# ════════════════════════════════════════════════════════════════════════════
#
# Use these flags to mock EXPENSIVE or UNRELIABLE external services:
#
# MOCK_ML_PREDICTIONS=true       # Use dummy ML predictions
# MOCK_PAYMENT_SERVICE=true      # Use dummy payment responses
# SEED_DATABASE=true             # Auto-populate with test data
#
# ════════════════════════════════════════════════════════════════════════════
# TROUBLESHOOTING
# ════════════════════════════════════════════════════════════════════════════
#
# Error: "Connection refused" for DATABASE_URL
#   → Ensure MySQL is running: docker ps | grep mysql
#   → Verify DATABASE_URL format: mysql://user:pass@host:port/db
#
# Error: "Invalid API Key" for Google Maps
#   → Check API key is enabled for Maps API (not just generated)
#   → Verify billing is enabled on GCP project
#
# Error: "Authentication failed" for GCP
#   → Ensure gcp-service-key.json exists at GOOGLE_CREDENTIALS_PATH
#   → Check service account has required roles (see GCP section above)
#
# Error: "Redis connection error"
#   → Start Redis: docker-compose up -d
#   → Check REDIS_URL matches docker-compose port
#
# Can't use Gmail AppPassword?
#   → Use SMTP relay service: mailtrap.io, sendgrid.com
#   → Or enable "Less secure app access" (not recommended for production)
#
# ════════════════════════════════════════════════════════════════════════════
# COMMON CREDENTIAL COMBINATIONS
# ════════════════════════════════════════════════════════════════════════════
#
# Scenario 1: Minimal Local Development
# ─────────────────────────────────────────────────────────
# Use: LOCAL MySQL + Redis
# Skip: GCP, AWS, Stripe, 3rd-party APIs
# Set: MOCK_ML_PREDICTIONS=true, MOCK_PAYMENT_SERVICE=true
#
# Scenario 2: Full-stack with GCP (Recommended)
# ─────────────────────────────────────────────────────────
# Use: GCP Cloud SQL + Memorystore + Cloud Storage
# Add: GCP service account key, Google Maps API key
# Set: GOOGLE_PROJECT_ID, GOOGLE_CREDENTIALS_PATH
#
# Scenario 3: Production-Ready
# ─────────────────────────────────────────────────────────
# Use: GCP Secrets Manager (NOT this file)
# Add: Real Stripe keys, real email service
# Set: HTTPS_ONLY=true, real domain names
# Rotate: All credentials every 60-90 days
#
# ════════════════════════════════════════════════════════════════════════════
# REFERENCE LINKS & DOCUMENTATION
# ════════════════════════════════════════════════════════════════════════════
