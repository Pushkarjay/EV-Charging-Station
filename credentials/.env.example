# Environment Variables Template
# Copy this file to .env.local, .env.development, or .env.production
# and fill in with your actual values
# IMPORTANT: Never commit actual values - only commit this template with placeholders

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=mysql://username:password@localhost:3306/ev_charging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_RELOAD=true
ENVIRONMENT=development

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# GOOGLE CLOUD PLATFORM (GCP)
# ============================================================================
GOOGLE_PROJECT_ID=ev-charging-dev
GOOGLE_CREDENTIALS_PATH=./credentials/keys/gcp-service-key.json
GCP_REGION=us-central1
GCP_BUCKET_NAME=ev-charging-dev-bucket

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_TIMEOUT=30000
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
REACT_APP_GOOGLE_MAPS_ID=your-google-maps-id-here
NEXT_PUBLIC_ENVIRONMENT=development

# ============================================================================
# MACHINE LEARNING / DATA SCIENCE
# ============================================================================
ML_MODEL_PATH=./data-science/models/demand_forecast_latest.pkl
ML_SERVICE_URL=http://localhost:8001
ML_BATCH_SIZE=100
ML_PREDICTION_TIMEOUT=60
PREDICTION_CACHE_TTL=3600

# ============================================================================
# EMAIL CONFIGURATION (for notifications and password reset)
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@evchargingstation.com
SMTP_FROM_NAME=EV Charging Station

# ============================================================================
# REDIS CONFIGURATION (for caching and sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600
CACHE_ENABLED=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# PAYMENT PROCESSING (Stripe - if applicable)
# ============================================================================
STRIPE_API_KEY=sk_test_your-test-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# ============================================================================
# THIRD-PARTY API KEYS
# ============================================================================
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_URL=https://api.openweathermap.org
TRAFFIC_API_KEY=your-traffic-api-key
MAPS_API_KEY=your-maps-platform-key

# ============================================================================
# GEOLOCATION & MAPPING
# ============================================================================
DEFAULT_MAP_CENTER_LAT=28.5355
DEFAULT_MAP_CENTER_LNG=77.3910
DEFAULT_MAP_ZOOM=12
MAP_SEARCH_RADIUS_KM=50

# ============================================================================
# FEATURE FLAGS (for gradual rollout)
# ============================================================================
FEATURE_DEMAND_FORECASTING=true
FEATURE_FAULT_DETECTION=true
FEATURE_USER_ANALYTICS=true
FEATURE_BILLING_INTEGRATION=false
FEATURE_MOBILE_APP=false

# ============================================================================
# RATE LIMITING & THROTTLING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_PER_USER=50

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id
SENTRY_ENVIRONMENT=development
DATADOG_API_KEY=your-datadog-api-key
DATADOG_ENVIRONMENT=development

# ============================================================================
# CELERY (for background tasks)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=900

# ============================================================================
# AWS (if using AWS instead of GCP)
# ============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ev-charging-bucket

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
DEBUG=false
DEVELOPMENT_MODE=false
MOCK_ML_PREDICTIONS=false
MOCK_PAYMENT_SERVICE=false
SEED_DATABASE=false

# ============================================================================
# KUBERNETES CONFIGURATION (if using K8s)
# ============================================================================
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=default
KUBERNETES_REPLICAS=3

# ============================================================================
# SECURITY
# ============================================================================
ALLOWED_HOSTS=localhost,127.0.0.1
HTTPS_ONLY=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ============================================================================
# PAGINATION & LIMITS
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_FILTER_RESULTS=1000

# ============================================================================
# TIME ZONE
# ============================================================================
TIME_ZONE=Asia/Kolkata
DATE_FORMAT=%d-%m-%Y
TIME_FORMAT=%H:%M:%S
