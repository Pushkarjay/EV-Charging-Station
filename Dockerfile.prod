FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --omit=dev

# Copy built frontend
COPY frontend/.next ./.next
COPY frontend/public ./public
COPY frontend/next.config.js ./

# Expose port
EXPOSE 3000

# Start Next.js in production mode
CMD ["npx", "next", "start"]
