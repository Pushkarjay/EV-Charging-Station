# Backend Environment Configuration File
# Copy this to .env and fill in the actual values

# ============================================
# 🗄️ DATABASE CONFIGURATION
# ============================================

# Default: SQLite (perfect for development)
# Production: Use PostgreSQL or MySQL
DATABASE_URL=sqlite:///./ev_charging.db

# Examples of other databases:
# PostgreSQL: postgresql://user:password@localhost:5432/ev_charging
# MySQL: mysql+pymysql://user:password@localhost:3306/ev_charging


# ============================================
# 🔐 SECURITY & JWT
# ============================================

# Secret key for JWT tokens (change this to something long and random!)
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-keep-it-safe-change-in-production

# JWT Algorithm (usually HS256)
JWT_ALGORITHM=HS256

# Token expiry time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ============================================
# 🌐 CORS & ALLOWED HOSTS
# ============================================

# Where requests can come from
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# Allowed domain names
ALLOWED_HOSTS=["localhost","127.0.0.1"]


# ============================================
# 💳 STRIPE PAYMENT (Optional but Recommended)
# ============================================

# Get from: https://dashboard.stripe.com/apikeys
# Test keys start with pk_test_ and sk_test_
# NEVER commit these keys to git!

# Stripe Secret Key (keep this private!)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Public Key (safe to expose in frontend)
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here


# ============================================
# 📧 EMAIL CONFIGURATION (Optional but Recommended)
# ============================================

# SMTP Server for sending emails
SMTP_SERVER=smtp.gmail.com

# SMTP Port (Gmail uses 587 for TLS)
SMTP_PORT=587

# Your Gmail address
SMTP_USERNAME=your-email@gmail.com

# Gmail App Password (NOT your regular password!)
# Get this from: https://myaccount.google.com/apppasswords
# Must have 2-Step Verification enabled
SMTP_PASSWORD=your-app-password-16-chars


# ============================================
# 🗺️ GOOGLE MAPS API (Optional but Recommended)
# ============================================

# Get from: https://console.cloud.google.com
# Enable Maps JavaScript API and Geocoding API

GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here


# ============================================
# 🔧 APPLICATION SETTINGS
# ============================================

# Debug mode (set to False in production)
DEBUG=True

# Application host and port
HOST=0.0.0.0
PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development


# ============================================
# ⚙️ OPTIONAL - Advanced Settings
# ============================================

# Email sender name
APP_NAME=EV Charging Station

# Support email address
SUPPORT_EMAIL=support@evcharging.com

# Admin email (for alerts)
ADMIN_EMAIL=admin@evcharging.com

# Maximum upload file size (in bytes, default 5MB)
MAX_UPLOAD_SIZE=5242880

# Request timeout (seconds)
REQUEST_TIMEOUT=30
