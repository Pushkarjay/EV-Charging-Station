# ⚠️ SECURITY WARNING ⚠️
# NEVER commit actual API keys or secrets to Git!
# Use this template to create a local .env.local file
# .env.local is in .gitignore and won't be committed

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps API (Get from: https://console.cloud.google.com/apis/credentials)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_MAPS_API_KEY_HERE

# Optional Integrations
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_AUTH_DOMAIN=your_auth_domain_here

# Feature Flags
NEXT_PUBLIC_ENABLE_MAPS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Environment
NEXT_PUBLIC_ENVIRONMENT=development
